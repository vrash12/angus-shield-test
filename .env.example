# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy anon key. Safe in the
# browser: Row Level Security limits every user to their own rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The secret key (sb_secret_...) or legacy service_role key.
# Used only by `npm run seed` on your machine to create the demo account.
# Never add it to Vercel or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The account behind the "Use demo account" button. Server-only.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=

# Optional. When set, the daily keep-alive cron must send it (Vercel does this
# automatically for crons when CRON_SECRET is set on the project).
CRON_SECRET=
